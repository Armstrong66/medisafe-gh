# Copy this file to .env and fill in your own API keys and optional settings.
# Do not commit .env itself.

# Required API keys
HF_TOKEN=your_huggingface_access_token
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_google_api_key
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
KHAYA_API_KEY=your_khaya_api_key
KHAYA_CREDENTIALS_PATH=/path/to/google/credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google/credentials.json

# Local or fallback API key
LOCAL_OPENAI_API_KEY=local

# Model and backend preferences
SCORER_BACKEND=policy_api
GEMINI_MODEL=gemini-2.5-flash
SCORER_POLICY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
LLAMAGUARD_MODEL_ID=meta-llama/Llama-Guard-3-1B
LLAMAGUARD_PTE_ARTIFACT=llama_guard_3_1b_pruned_xnnpack.pte
GEMMA_SECONDARY_MODEL=google/gemma-3-1b-it
GEMMA_SECONDARY_HF_BASE_URL=https://router.huggingface.co/v1
GEMMA_SECONDARY_MAX_TOKENS=16
GEMMA_SECONDARY_TRUST_REMOTE_CODE=false
GEMMA_SECONDARY_DEVICE_MAP=auto
GEMMA_SECONDARY_TORCH_DTYPE=float16
PHI3_MODEL=microsoft/Phi-3-mini-4k-instruct
BIOMISTRAL_MODEL=BioMistral/BioMistral-7B-SLERP
GPT4O_MODEL=gpt-4o
LOCAL_MODEL_BACKEND=hf_router
PHI3_BACKEND=hf_router
BIOMISTRAL_BACKEND=hf_router
LOCAL_MAX_NEW_TOKENS=512
LOCAL_TEMPERATURE=0
LOCAL_DEVICE_MAP=auto
LOCAL_TORCH_DTYPE=auto
LOCAL_QUANTIZATION=none
LOCAL_QUANTIZATION_FALLBACK=true
LOCAL_ATTN_IMPLEMENTATION=eager
LOCAL_TRUST_REMOTE_CODE=false
PHI3_LOCAL_BASE_URL=http://localhost:8000/v1
BIOMISTRAL_LOCAL_BASE_URL=http://localhost:8001/v1
PHI3_LOCAL_MODEL=microsoft/Phi-3-mini-4k-instruct
BIOMISTRAL_LOCAL_MODEL=BioMistral/BioMistral-7B-SLERP
SCORER_POLICY_RETRIES=4
SCORER_POLICY_RETRY_DELAY=2
GEMINI_RETRIES=4
GEMINI_RETRY_DELAY=2
HF_RETRIES=4
HF_RETRY_DELAY=2
NLLB_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
NLLB_SOURCE_LANG_TWI=aka_Latn
NLLB_TARGET_LANG_EN=eng_Latn
NLLB_MAX_NEW_TOKENS=256
GMASS_LOG_DIR=logs
GMASS_CONFIG_DIR=configs
