# G-MASS Environment Configuration
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your keys below
# 3. Never commit .env to GitHub — it is in .gitignore
# ─────────────────────────────────────────────────────────────

# ── Model API Keys ────────────────────────────────────────────

# OpenAI — GPT-4o mini
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google — Gemini 1.5 Flash
# Get at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=...

# GhanaNLP Khaya — translation + TTS
# Request at: https://ghananlp.org or translation-api.ghananlp.org
KHAYA_API_KEY=...

# HuggingFace — model downloads (LlamaGuard3 is gated, requires token)
# Get at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# ── Cloudflare Workers AI (Kaggle fallback for LlamaGuard3) ──
# Only needed if running on Kaggle where local GPU is unavailable
# Get at: https://dash.cloudflare.com → Workers AI
CF_ACCOUNT_ID=...
CF_API_TOKEN=...

# ── G-MASS Runtime Settings ───────────────────────────────────

# Log verbosity: DEBUG | INFO | WARNING | ERROR
GMASS_LOG_LEVEL=INFO

# Path to fasttext LID model (downloaded automatically by Dockerfile)
# On local setup, run: scripts/download_models.sh
FASTTEXT_LID_PATH=models/fasttext/lid.176.bin

# ── Local Model Setup (no keys needed — just Ollama) ─────────
# LLaMA-3.2 3B and Phi-3 Mini run via Ollama (free, local)
# Setup (run once):
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull llama3.2:3b
#   ollama pull phi3:mini
#   ollama serve   ← keep this running in a separate terminal

# BioMistral-7B runs via HuggingFace Transformers (requires HF_TOKEN above)
# Downloads ~14GB on first run — ensure disk space
# RTX strongly recommended for BioMistral (CPU will be very slow)
